# .env —— 由安装程序自动生成，禁止手动提交到版本库（规范 § 8.2.3）
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=wtzy
DB_USER=wtzy_user
DB_PASS=
DB_PREFIX=wt_
DB_CHARSET=utf8mb4

# 密钥（安装时自动生成随机值）
APP_KEY=base64:
CSRF_TOKEN_SECRET=

# 多语言 / 多币种默认值
APP_DEFAULT_LANG=zh-CN
APP_DEFAULT_CURRENCY=CNY
APP_DEFAULT_TIMEZONE=Asia/Shanghai

# 可选：第三方服务（P1 阶段接入）
# 邮件发送（找回密码验证码依赖此项；未填写则邮件相关功能自动停用）
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_SECURE=ssl
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=
# MAIL_FROM_NAME=WTZY 全球转运

# SMS_PROVIDER=

# 支付网关（易支付）在后台「运营支撑 → 充值设置」中维护（商户号/密钥/发起方式），不在此配置
# 服务器缺少 CA 证书导致支付网关 HTTPS 校验失败时，把 CA 证书放到 storage/cacert.pem，
# 或在 php.ini 中设置 curl.cainfo / openssl.cafile 指向证书包
